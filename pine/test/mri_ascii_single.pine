// ---------------------------------------------------------------- weights: 36961 float32, 184805 ASCII characters (5 per weight) in 47 strings
buildAlpha() =>
    map<string, int> m = map.new<string, int>()
    array<string> cs = str.split("!#$%&'()*+,-.0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~", "")
    for [i, c] in cs
        map.put(m, c, i)
    m

decodeInto(array<float> dst, map<string, int> A, string s) =>
    array<string> cs = str.split(s, "")
    int n = math.floor(array.size(cs) / 5.0)
    for k = 0 to n - 1
        float b = 0.0
        for j = 0 to 4
            b := b * 91.0 + map.get(A, array.get(cs, 5 * k + j))
        float sg = b >= 2147483648.0 ? -1.0 : 1.0
        float u = b >= 2147483648.0 ? b - 2147483648.0 : b
        float e = math.floor(u / 8388608.0)
        float m = u - e * 8388608.0
        float v = e == 0 ? m * math.pow(2.0, -149) : (1.0 + m / 8388608.0) * math.pow(2.0, e - 127)
        array.push(dst, sg * v)
    true

