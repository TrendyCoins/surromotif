var map<string, float> FLOORS = buildFloors()
var map<string, float> PLA    = buildPlattA()
var map<string, float> PLB    = buildPlattB()
var map<string, float> CEILO  = buildCeilMore()
var map<string, float> CEILB  = buildCeilLess()
bool  known = syminfo.prefix == "BINANCE" and not str.endswith(syminfo.ticker, ".P") and map.contains(FLOORS, syminfo.ticker)
var float FLOOR   = known ? map.get(FLOORS, syminfo.ticker) : 0.20000000298023224
var float PLATT_A = known ? map.get(PLA, syminfo.ticker) : 0.8142369985580444
var float PLATT_B = known ? map.get(PLB, syminfo.ticker) : -0.31652188301086426
var float CEIL_O  = known ? map.get(CEILO, syminfo.ticker) : 8.0   // checked range of M, more frequent side
var float CEIL_B  = known ? map.get(CEILB, syminfo.ticker) : 1.5   // checked range of M, less frequent side
bool  tf5   = timeframe.period == "5"
float GAPMS = 1.5 * timeframe.in_seconds() * 1000.0   // interval > 1.5 bars -> grid gap

// ---------------------------------------------------------------- constants
const int   L      = 64
const int   NN     = 200          // bars of the range median (the norm of a bar) and of the history before a window
const int   CH     = 48           // conv channels
const int   HID    = 96           // hidden units of the head
const int   NS     = 17           // side inputs
const float EPS    = 0.0001       // orientation tie rule: flip only if X_end < -EPS * D
const float SQ199  = 14.106735979665885
const float S_SD   = 1.640539288520813
const float LVL_SD = 3.028594493865967
var array<float> SIDE_MU = array.from(-0.7283339500427246, -0.47306308150291443, -0.0017850924050435424, -0.009280271828174591, -0.010675457306206226, -0.012358603067696095, -0.008352444507181644, -0.00936533510684967, -0.00594957685098052, -0.010362531989812851, -0.01310903113335371, 0.2680075764656067, -0.013571053743362427, -0.05120363086462021, -0.021999502554535866, 0.17020025849342346, -0.7806834578514099)
