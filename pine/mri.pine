var map<string, float> FLOORS = buildFloors()
bool  known = syminfo.prefix == "BINANCE" and not str.endswith(syminfo.ticker, ".P") and map.contains(FLOORS, syminfo.ticker)
var float FLOOR = known ? map.get(FLOORS, syminfo.ticker) : 0.20000000298023224
bool  tf5   = timeframe.period == "5"
float GAPMS = 1.5 * timeframe.in_seconds() * 1000.0   // interval > 1.5 bars -> grid gap
const float PLATT_A = 0.8216076493263245
const float PLATT_B = -0.22872847318649292
const float CEIL_O  = 21.0   // checked range of M, more frequent side (rule R9)
const float CEIL_B  = 21.0   // checked range of M, less frequent side

